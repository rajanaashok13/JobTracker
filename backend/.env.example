# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local MongoDB)
# Replace with your actual Atlas connection URI:
# mongodb+srv://<username>:<password>@<cluster-url>/jobtrack?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jobtrack?retryWrites=true&w=majority

# JWT Authentication Configuration
# Use a strong, random 256-bit secret in production
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRE=30d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
